# ==========================================
# DeepGuard Project .gitignore
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/
**/venv_tf/
**/venv*/

# Frontend / Node dependencies & build artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.oxlint_cache/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files and credentials
.env
.env.local
.env.*.local
*.env
!*.env.example

# IDE and editor settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Operating System files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
.DS_Store
.AppleDouble
.LSOverride

# Logs & temporary files
*.log
logs/
*.tmp
*.temp

# Large dataset raw files and uncompressed archives (>20GB total)
archive/
data/raw/

# Model checkpoints exceeding GitHub 100MB file limit (ViT 982MB, Xception 238MB)
image_branch/experiments/vit/best_model.pth
image_branch/experiments/xception/best_model.pth

# Temporary user uploads (preserve directory structure via .gitkeep)
uploads/*
!uploads/.gitkeep
